# Public ports. The API is loopback-only by default because the client proxies it.
CLIENT_PORT=3000
API_BIND=127.0.0.1
API_PORT=8000

# Host paths mounted read-only into the FastAPI container.
FASHION_MODELS_PATH=./models
FASHION_DATA_ROOT=./dataset

# Optional image names for a registry-backed Portainer deployment.
SERVER_IMAGE=fashion-intelligence-server:latest
CLIENT_IMAGE=fashion-intelligence-client:latest
